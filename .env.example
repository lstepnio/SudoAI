SUDOAI_URL=https://sudoai.example.com
SUDOAI_ISSUER=https://auth.example.com/application/o/sudoai/
SUDOAI_CLIENT_ID=replace-with-your-oidc-client-id
SUDOAI_CLIENT_SECRET=replace-with-your-oidc-client-secret
SUDOAI_GROUP=SudoAI Users
SUDOAI_DATA=/data
SUDOAI_MEDIA=/media
SUDOAI_OPENAI_KEY_FILE=/run/secrets/sudoai-openai
SUDOAI_TEXT_MODEL=gpt-5-mini
SUDOAI_SPEECH_MODEL=gpt-transcribe
